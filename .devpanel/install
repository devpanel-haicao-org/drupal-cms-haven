#!/usr/bin/env php
<?php

/**
 * @file
 * Script to install Drupal CMS with the Haven template.
 *
 * This runs the full drupal_cms installation profile and applies
 * all required recipes including the Haven theme and demo content,
 * without requiring the interactive UI installer.
 *
 * Based on Hooks::applyRecipes() source: install_state['parameters']['recipes']
 * is merged from GET params. The package name must be the full Composer name.
 */

// Inject the haven recipe via GET parameters.
// Hooks::applyRecipes() reads: $install_state['parameters']['recipes']
// which comes from GET params processed by install.php before any task runs.
$_GET['rewrite'] = 'ok';
$_GET['site_name'] = 'Drupal CMS Haven';
// The 'recipes' parameter must use the full Composer package name.
$_GET['recipes'] = ['drupal/haven'];

chdir(dirname(__DIR__) . '/web/core');
ob_start(fn($buffer, $phase) => TRUE, 1);
include 'install.php';
