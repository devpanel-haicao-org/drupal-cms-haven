#!/usr/bin/env php
<?php

/**
 * @file
 * Script to run one step of the Drupal CMS installation with Haven template.
 *
 * Each invocation processes one install task or batch step.
 * Must be called in a loop until install_task state equals 'done'.
 *
 * No shutdown function is used - install.php handles everything naturally,
 * processing one task per invocation in interactive-simulation mode.
 */

// Pre-fill all installer forms via GET parameters.
$_GET['rewrite'] = 'ok';
$_GET['site_name'] = 'Drupal CMS Haven';
$_GET['template'] = '1';
// Tell RecipeKit which recipes to apply (Composer package names).
$_GET['recipes'] = ['drupal/haven'];

chdir(dirname(__DIR__) . '/web/core');
ob_start(fn($buffer, $phase) => TRUE, 1);
include 'install.php';
